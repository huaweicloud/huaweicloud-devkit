{
  "name": "huaweicloud-devkit",
  "mcpName": "io.github.huaweicloud/huaweicloud-devkit",
  "version": "1.1.7",
  "kooCliVersion": "7.2.12",
  "description": "Agent toolkit that helps coding agents use Huawei Cloud Skills, KooCLI, APIs, SDKs, and future MCP capabilities safely and accurately.",
  "type": "module",
  "files": [
    "cordis.patch.yml",
    "bin",
    ".agents",
    "plugins/huaweicloud-core",
    "integrations/hermes",
    "integrations/opencode",
    "integrations/dsh",
    "integrations/workbuddy",
    "integrations/atomcode"
  ],
  "bin": {
    "huaweicloud-devkit": "./bin/setup.cjs",
    "huaweicloud-devkit-mcp": "./plugins/huaweicloud-core/dist/mcp-server.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huaweicloud/huaweicloud-devkit.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node ./scripts/build-plugin.mjs",
    "typecheck": "tsc -p plugins/huaweicloud-core/tsconfig.json --noEmit",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "node --experimental-test-module-mocks --test \"test/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.git\" \"#test/**\" \"#docs/**\" \"#.superpowers/**\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:md && npm run lint:js",
    "validate": "node ./scripts/validate-package.mjs && node ./scripts/sync-readme-badge.mjs",
    "badge:sync": "node ./scripts/sync-readme-badge.mjs --write",
    "pack:verify": "node ./scripts/pack-verify.mjs",
    "postinstall": "node ./bin/dsh-postinstall.cjs"
  },
  "dependencies": {
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "overrides": {
    "smol-toml": "1.8.0"
  },
  "keywords": [
    "huaweicloud",
    "huawei-cloud",
    "agent",
    "codex",
    "opencode",
    "codearts",
    "codearts-work",
    "officeace",
    "office-claw",
    "workbuddy",
    "atomcode",
    "dsh",
    "deepseek-harness",
    "mcp",
    "koocli",
    "hcloud"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  }
}
