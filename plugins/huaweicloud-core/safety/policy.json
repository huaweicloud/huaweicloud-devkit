{
  "version": "0.1.0",
  "secretKeyNamePatterns": [
    "access[_-]?key",
    "secret[_-]?key",
    "security[_-]?token",
    "x[_-]?auth[_-]?token",
    "authorization",
    "password",
    "passwd",
    "token",
    "credential",
    "private[_-]?key",
    "user[_-]?data",
    "metadata",
    "ak",
    "sk"
  ],
  "credentialFilePatterns": [
    "\\.hcloud",
    "\\.huaweicloud",
    "hcloud[/\\\\](config|credentials)",
    "huaweicloud[/\\\\](config|credentials|creds-import)",
    "huaweicloud[/\\\\]secrets",
    "\\.master-key",
    "creds-import\\.json",
    "/proc/(self|[0-9]+)/environ",
    "huaweicloud\\s*(?:&&|;|/|[\\n\\r])\\s*(?:\\S+\\s+){0,2}(?:credentials|creds-import|config)\\.json"
  ],
  "blockedConfigureSubcommands": ["show", "get", "list", "export", "init"],
  "blockedSecretOperations": [
    "ShowSecret",
    "ShowSecretVersion",
    "DownloadSecret",
    "GetSecretValue",
    "DecryptData",
    "DecryptDatakey",
    "DownloadAccessPointPrivateKey",
    "DeriveSharedSecret",
    "CreateRsaDatakeyPair",
    "CreateEcDatakeyPair"
  ],
  "blockedSecretCliPatterns": [
    "huaweicloud-devkit(@[\\w.+-]+)?(\\.(js|cjs|mjs|exe|ts))?(\\s+--)?\\s+secret\\s+get\\b",
    "setup-cli\\.(js|mjs|ts)(\\s+--)?\\s+secret\\s+get\\b",
    "setup\\.cjs(\\s+--)?\\s+secret\\s+get\\b"
  ],
  "writeOperationPrefixes": [
    "Create",
    "BatchCreate",
    "Delete",
    "BatchDelete",
    "Update",
    "Modify",
    "Resize",
    "Reboot",
    "Stop",
    "Start",
    "Restart",
    "Apply",
    "Authorize",
    "Revoke",
    "Add",
    "Remove",
    "Associate",
    "Disassociate",
    "Attach",
    "Detach",
    "Enable",
    "Disable",
    "Set",
    "Put",
    "Upload",
    "Install",
    "Publish",
    "Bind",
    "Unbind",
    "Invoke",
    "Execute",
    "Trigger",
    "Deploy",
    "Rotate",
    "Cancel",
    "Confirm",
    "Subscribe",
    "Register",
    "Restore",
    "Migrate",
    "Import",
    "Uninstall",
    "Assign"
  ],
  "readOperationPrefixes": ["List", "Show", "Get", "Describe", "NovaList", "NovaShow", "GlanceShow", "GlanceList"],
  "readOperationExceptions": [
    "MigrateResults",
    "ImportResult",
    "DownloadImportResult",
    "DownloadImportTemplate",
    "DownloadImportExcelTemplate",
    "RecognizeHouseholdRegister",
    "CollectPolicyAssignmentsStatesSummary",
    "CheckMigrateLogicDb"
  ],
  "safeTextReadCommands": ["rg", "grep", "findstr", "git", "ls", "dir", "Get-ChildItem"],
  "blockedSandboxCommands": [
    "rm\\s+-rf\\s+/",
    "mkfs",
    "dd\\s+if=",
    ":\\(\\)\\{:\\|:&\\};:",
    "shutdown",
    "reboot",
    "init\\s+[06]",
    "fdisk"
  ],
  "sandboxWriteTools": [
    "huaweicloud_sandbox_connect",
    "huaweicloud_sandbox_credentials",
    "huaweicloud_sandbox_upload_file"
  ]
}
