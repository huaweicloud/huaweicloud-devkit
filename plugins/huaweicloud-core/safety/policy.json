{
  "version": "0.1.0",
  "agentartsSdkVersion": "0.1.7",
  "secretKeyNamePatterns": [
    "access[_-]?key",
    "secret[_-]?key",
    "security[_-]?token",
    "x[_-]?auth[_-]?token",
    "authorization",
    "password",
    "passwd",
    "token",
    "credential",
    "private[_-]?key",
    "user[_-]?data",
    "metadata",
    "api[_-]?key",
    "x[_-]?api[_-]?key",
    "ak",
    "sk",
    "secret"
  ],
  "credentialFilePatterns": [
    "\\.hcloud(?![.\\w])",
    "\\.huaweicloud(?![.\\w])",
    "hcloud[/\\\\](config|credentials)",
    "huaweicloud[/\\\\](config|credentials)",
    "\\.agentarts_config",
    "agentarts-memory-api-key",
    "\\.env"
  ],
  "blockedConfigureSubcommands": ["show", "get", "list", "export", "init"],
  "blockedSecretOperations": ["ShowSecret", "ShowSecretVersion", "DownloadSecret", "GetSecretValue"],
  "writeOperationPrefixes": [
    "Create",
    "BatchCreate",
    "Delete",
    "BatchDelete",
    "Update",
    "Modify",
    "Resize",
    "Reboot",
    "Stop",
    "Start",
    "Restart",
    "Apply",
    "Authorize",
    "Revoke",
    "Add",
    "Remove",
    "Associate",
    "Disassociate",
    "Attach",
    "Detach",
    "Enable",
    "Disable",
    "Set",
    "Put",
    "Upload",
    "Install",
    "Publish",
    "Bind",
    "Unbind",
    "Invoke",
    "Execute",
    "Trigger",
    "Deploy"
  ],
  "readOperationPrefixes": ["List", "Show", "Get", "Describe", "NovaList", "NovaShow"],
  "safeTextReadCommands": ["rg", "grep", "findstr", "git", "ls", "dir", "Get-ChildItem"],
  "blockedSandboxCommands": [
    "rm\\s+-rf\\s+/",
    "mkfs",
    "dd\\s+if=",
    ":\\(\\)\\{:\\|:&\\};:",
    "shutdown",
    "reboot",
    "init\\s+[06]",
    "fdisk"
  ],
  "sandboxWriteTools": [
    "huaweicloud_sandbox_connect",
    "huaweicloud_sandbox_credentials",
    "huaweicloud_sandbox_upload_file"
  ],
  "agentartsCommandPolicy": {
    "aliases": {
      "deploy": "launch",
      "configure": "config"
    },
    "defaultTier": "approved",
    "commands": {
      "init": {
        "tier": "local"
      },
      "dev": {
        "tier": "local"
      },
      "config": {
        "tier": "approved",
        "labels": ["credential-guard"],
        "subcommands": {
          "list": {
            "tier": "approved",
            "labels": ["credential-guard"]
          },
          "set-default": {
            "tier": "approved",
            "labels": ["credential-guard"]
          },
          "get": {
            "tier": "approved",
            "labels": ["credential-guard"]
          },
          "set": {
            "tier": "approved",
            "labels": ["credential-guard"]
          },
          "remove": {
            "tier": "approved",
            "labels": ["credential-guard"]
          },
          "set-env": {
            "tier": "approved",
            "labels": ["credential-guard"]
          },
          "remove-env": {
            "tier": "approved",
            "labels": ["credential-guard"]
          },
          "list-env": {
            "tier": "approved",
            "labels": ["credential-guard"]
          }
        }
      },
      "launch": {
        "tier": "approved",
        "labels": ["billing"]
      },
      "destroy": {
        "tier": "approved",
        "labels": ["irreversible"]
      },
      "invoke": {
        "tier": "approved",
        "labels": ["execute"]
      },
      "memory": {
        "tier": "approved",
        "subcommands": {
          "list": {
            "tier": "readonly"
          },
          "get": {
            "tier": "readonly"
          },
          "status": {
            "tier": "readonly"
          },
          "create": {
            "tier": "approved"
          },
          "update": {
            "tier": "approved"
          },
          "delete": {
            "tier": "approved",
            "labels": ["irreversible"]
          },
          "install": {
            "tier": "approved",
            "labels": ["host-trust"]
          },
          "uninstall": {
            "tier": "approved",
            "labels": ["host-trust"]
          }
        }
      },
      "gateway": {
        "tier": "approved",
        "subcommands": {
          "get": {
            "tier": "readonly"
          },
          "list": {
            "tier": "readonly"
          },
          "get-target": {
            "tier": "readonly"
          },
          "list-targets": {
            "tier": "readonly"
          },
          "create": {
            "tier": "approved",
            "labels": ["billing"]
          },
          "update": {
            "tier": "approved",
            "labels": ["billing"]
          },
          "delete": {
            "tier": "approved",
            "labels": ["irreversible"]
          },
          "create-target": {
            "tier": "approved",
            "labels": ["billing", "credential-guard"]
          },
          "update-target": {
            "tier": "approved",
            "labels": ["billing", "credential-guard"]
          },
          "delete-target": {
            "tier": "approved",
            "labels": ["irreversible"]
          }
        }
      },
      "runtime": {
        "tier": "approved",
        "subcommands": {
          "invoke": {
            "tier": "approved",
            "labels": ["execute"]
          },
          "exec-command": {
            "tier": "approved",
            "labels": ["rce"]
          },
          "upload-files": {
            "tier": "approved",
            "labels": ["data-exfil"]
          },
          "download-files": {
            "tier": "approved",
            "labels": ["local-write"]
          },
          "start-session": {
            "tier": "approved",
            "labels": ["execute"]
          },
          "stop-session": {
            "tier": "approved",
            "labels": ["execute"]
          }
        }
      }
    }
  }
}
